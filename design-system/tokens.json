{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Lease Buddy Design Tokens",
    "version": "1.0.0",
    "author": "Jo — UI/UX Design Agent",
    "date": "2026-10-04",
    "format": "W3C DTCG"
  },

  "color": {
    "$description": "Color primitives and semantic aliases",

    "primitive": {
      "warm-white": { "$value": "#faf9f6", "$type": "color" },
      "paper":      { "$value": "#f4f2ed", "$type": "color" },
      "parchment":  { "$value": "#ede9e0", "$type": "color" },
      "ink":        { "$value": "#1a1a1a", "$type": "color" },
      "graphite":   { "$value": "#3d3d3d", "$type": "color" },
      "slate":      { "$value": "#6b7280", "$type": "color" },
      "fog":        { "$value": "#9ca3af", "$type": "color" },
      "white":      { "$value": "#ffffff", "$type": "color" },

      "sage": {
        "50":  { "$value": "#eef3f0", "$type": "color" },
        "100": { "$value": "#d4e4dc", "$type": "color" },
        "300": { "$value": "#8ab5a4", "$type": "color" },
        "500": { "$value": "#5c7a6b", "$type": "color" },
        "700": { "$value": "#3d5a4f", "$type": "color" },
        "900": { "$value": "#1e2e28", "$type": "color" }
      },

      "amber": {
        "300": { "$value": "#fcd34d", "$type": "color" },
        "500": { "$value": "#f59e0b", "$type": "color" }
      },

      "red": {
        "100": { "$value": "#fee2e2", "$type": "color" },
        "400": { "$value": "#f87171", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" }
      },

      "green": {
        "100": { "$value": "#dcfce7", "$type": "color" },
        "400": { "$value": "#4ade80", "$type": "color" },
        "600": { "$value": "#16a34a", "$type": "color" }
      },

      "dark": {
        "base":           { "$value": "#0f1117", "$type": "color" },
        "surface":        { "$value": "#1a1d27", "$type": "color" },
        "surface-raised": { "$value": "#22263a", "$type": "color" },
        "border":         { "$value": "#2a2d3a", "$type": "color" },
        "text-primary":   { "$value": "#f0ede8", "$type": "color" },
        "text-secondary": { "$value": "#9ca3af", "$type": "color" },
        "text-muted":     { "$value": "#6b7280", "$type": "color" }
      }
    },

    "semantic": {
      "$description": "Semantic aliases — reference these in components",

      "background": {
        "app":     { "$value": "{color.primitive.warm-white}", "$type": "color" },
        "surface": { "$value": "{color.primitive.paper}", "$type": "color" },
        "inset":   { "$value": "{color.primitive.parchment}", "$type": "color" },
        "overlay": { "$value": "rgba(26, 26, 26, 0.48)", "$type": "color" }
      },

      "text": {
        "primary":     { "$value": "{color.primitive.ink}", "$type": "color" },
        "secondary":   { "$value": "{color.primitive.graphite}", "$type": "color" },
        "muted":       { "$value": "{color.primitive.slate}", "$type": "color" },
        "placeholder": { "$value": "{color.primitive.fog}", "$type": "color" },
        "disabled":    { "$value": "{color.primitive.fog}", "$type": "color" },
        "on-accent":   { "$value": "{color.primitive.white}", "$type": "color" }
      },

      "border": {
        "default": { "$value": "{color.primitive.parchment}", "$type": "color" },
        "strong":  { "$value": "{color.primitive.slate}", "$type": "color" },
        "focus":   { "$value": "{color.primitive.sage.500}", "$type": "color" }
      },

      "accent": {
        "default":    { "$value": "{color.primitive.sage.500}", "$type": "color" },
        "hover":      { "$value": "{color.primitive.sage.700}", "$type": "color" },
        "pressed":    { "$value": "{color.primitive.sage.700}", "$type": "color" },
        "subtle":     { "$value": "{color.primitive.sage.50}", "$type": "color" },
        "muted":      { "$value": "{color.primitive.sage.100}", "$type": "color" },
        "on-accent":  { "$value": "{color.primitive.white}", "$type": "color" }
      },

      "status": {
        "error-bg":       { "$value": "{color.primitive.red.100}", "$type": "color" },
        "error-text":     { "$value": "{color.primitive.red.600}", "$type": "color" },
        "error-border":   { "$value": "{color.primitive.red.400}", "$type": "color" },
        "warning-bg":     { "$value": "#fffbeb", "$type": "color" },
        "warning-text":   { "$value": "{color.primitive.amber.500}", "$type": "color" },
        "warning-border": { "$value": "{color.primitive.amber.300}", "$type": "color" },
        "success-bg":     { "$value": "{color.primitive.green.100}", "$type": "color" },
        "success-text":   { "$value": "{color.primitive.green.600}", "$type": "color" },
        "success-border": { "$value": "{color.primitive.green.400}", "$type": "color" },
        "info-bg":        { "$value": "{color.primitive.sage.50}", "$type": "color" },
        "info-text":      { "$value": "{color.primitive.sage.700}", "$type": "color" },
        "info-border":    { "$value": "{color.primitive.sage.100}", "$type": "color" }
      },

      "dark": {
        "background": {
          "app":     { "$value": "{color.primitive.dark.base}", "$type": "color" },
          "surface": { "$value": "{color.primitive.dark.surface}", "$type": "color" },
          "inset":   { "$value": "{color.primitive.dark.surface-raised}", "$type": "color" },
          "overlay": { "$value": "rgba(0, 0, 0, 0.64)", "$type": "color" }
        },
        "text": {
          "primary":     { "$value": "{color.primitive.dark.text-primary}", "$type": "color" },
          "secondary":   { "$value": "{color.primitive.dark.text-secondary}", "$type": "color" },
          "muted":       { "$value": "{color.primitive.dark.text-muted}", "$type": "color" },
          "placeholder": { "$value": "{color.primitive.dark.text-muted}", "$type": "color" },
          "disabled":    { "$value": "{color.primitive.dark.text-muted}", "$type": "color" },
          "on-accent":   { "$value": "{color.primitive.white}", "$type": "color" }
        },
        "border": {
          "default": { "$value": "{color.primitive.dark.border}", "$type": "color" },
          "strong":  { "$value": "{color.primitive.slate}", "$type": "color" },
          "focus":   { "$value": "{color.primitive.sage.300}", "$type": "color" }
        },
        "accent": {
          "default":   { "$value": "{color.primitive.sage.300}", "$type": "color" },
          "hover":     { "$value": "{color.primitive.sage.100}", "$type": "color" },
          "pressed":   { "$value": "{color.primitive.sage.500}", "$type": "color" },
          "subtle":    { "$value": "{color.primitive.sage.900}", "$type": "color" },
          "muted":     { "$value": "rgba(92, 122, 107, 0.2)", "$type": "color" },
          "on-accent": { "$value": "{color.primitive.dark.base}", "$type": "color" }
        }
      }
    }
  },

  "typography": {
    "$description": "Typography tokens — Inter typeface",

    "font-family": {
      "base": {
        "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
        "$type": "fontFamily"
      }
    },

    "font-size": {
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "md":   { "$value": "18px", "$type": "dimension" },
      "lg":   { "$value": "20px", "$type": "dimension" },
      "xl":   { "$value": "24px", "$type": "dimension" },
      "2xl":  { "$value": "30px", "$type": "dimension" },
      "3xl":  { "$value": "38px", "$type": "dimension" }
    },

    "font-weight": {
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "medium":   { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    },

    "line-height": {
      "tight":   { "$value": "1.2",  "$type": "number" },
      "snug":    { "$value": "1.35", "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.65", "$type": "number" }
    },

    "letter-spacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em",     "$type": "dimension" },
      "wide":   { "$value": "0.04em",  "$type": "dimension" },
      "widest": { "$value": "0.08em",  "$type": "dimension" }
    }
  },

  "spacing": {
    "$description": "4px base grid",
    "0":   { "$value": "0px",   "$type": "dimension" },
    "1":   { "$value": "4px",   "$type": "dimension" },
    "2":   { "$value": "8px",   "$type": "dimension" },
    "3":   { "$value": "12px",  "$type": "dimension" },
    "4":   { "$value": "16px",  "$type": "dimension" },
    "5":   { "$value": "20px",  "$type": "dimension" },
    "6":   { "$value": "24px",  "$type": "dimension" },
    "7":   { "$value": "28px",  "$type": "dimension" },
    "8":   { "$value": "32px",  "$type": "dimension" },
    "10":  { "$value": "40px",  "$type": "dimension" },
    "12":  { "$value": "48px",  "$type": "dimension" },
    "14":  { "$value": "56px",  "$type": "dimension" },
    "16":  { "$value": "64px",  "$type": "dimension" },
    "20":  { "$value": "80px",  "$type": "dimension" },
    "24":  { "$value": "96px",  "$type": "dimension" }
  },

  "border-radius": {
    "none":  { "$value": "0px",   "$type": "dimension" },
    "sm":    { "$value": "4px",   "$type": "dimension" },
    "md":    { "$value": "8px",   "$type": "dimension" },
    "lg":    { "$value": "12px",  "$type": "dimension" },
    "xl":    { "$value": "16px",  "$type": "dimension" },
    "2xl":   { "$value": "24px",  "$type": "dimension" },
    "full":  { "$value": "9999px","$type": "dimension" }
  },

  "shadow": {
    "$description": "Warm-tinted shadows using ink color",
    "none": { "$value": "none", "$type": "shadow" },
    "xs": {
      "$value": "0 1px 2px rgba(26, 26, 26, 0.06)",
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 1px 3px rgba(26, 26, 26, 0.08), 0 1px 2px rgba(26, 26, 26, 0.06)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px rgba(26, 26, 26, 0.06), 0 2px 4px rgba(26, 26, 26, 0.08)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 10px 15px rgba(26, 26, 26, 0.08), 0 4px 6px rgba(26, 26, 26, 0.05)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 20px 25px rgba(26, 26, 26, 0.10), 0 10px 10px rgba(26, 26, 26, 0.04)",
      "$type": "shadow"
    },
    "inner": {
      "$value": "inset 0 2px 4px rgba(26, 26, 26, 0.06)",
      "$type": "shadow"
    },
    "focus-ring": {
      "$value": "0 0 0 3px rgba(92, 122, 107, 0.32)",
      "$type": "shadow"
    },
    "focus-ring-error": {
      "$value": "0 0 0 3px rgba(220, 38, 38, 0.24)",
      "$type": "shadow"
    }
  },

  "z-index": {
    "$description": "Stacking context layers",
    "base":     { "$value": "0",    "$type": "number" },
    "raised":   { "$value": "10",   "$type": "number" },
    "dropdown": { "$value": "100",  "$type": "number" },
    "sticky":   { "$value": "200",  "$type": "number" },
    "overlay":  { "$value": "300",  "$type": "number" },
    "modal":    { "$value": "400",  "$type": "number" },
    "toast":    { "$value": "500",  "$type": "number" },
    "tooltip":  { "$value": "600",  "$type": "number" }
  },

  "motion": {
    "duration": {
      "instant":  { "$value": "0ms",   "$type": "duration" },
      "fast":     { "$value": "100ms", "$type": "duration" },
      "normal":   { "$value": "150ms", "$type": "duration" },
      "moderate": { "$value": "200ms", "$type": "duration" },
      "slow":     { "$value": "300ms", "$type": "duration" }
    },
    "easing": {
      "standard":    { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",       "$type": "cubicBezier" },
      "decelerate":  { "$value": "cubic-bezier(0, 0, 0.2, 1)",         "$type": "cubicBezier" },
      "accelerate":  { "$value": "cubic-bezier(0.4, 0, 1, 1)",         "$type": "cubicBezier" },
      "spring":      { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",  "$type": "cubicBezier" }
    }
  },

  "border-width": {
    "none":   { "$value": "0px", "$type": "dimension" },
    "thin":   { "$value": "1px", "$type": "dimension" },
    "medium": { "$value": "2px", "$type": "dimension" },
    "thick":  { "$value": "4px", "$type": "dimension" }
  },

  "icon": {
    "size": {
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "16px", "$type": "dimension" },
      "md":   { "$value": "20px", "$type": "dimension" },
      "base": { "$value": "24px", "$type": "dimension" },
      "lg":   { "$value": "32px", "$type": "dimension" }
    },
    "stroke-width": {
      "default": { "$value": "1.5", "$type": "number" }
    }
  }
}
