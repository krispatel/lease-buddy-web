{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Lease Buddy Design Tokens V2",
    "version": "2.0.0",
    "author": "Jo -- UI/UX Design Agent",
    "date": "2026-10-04",
    "format": "W3C DTCG",
    "description": "V2 evolution: sharp corners (0px radius everywhere), underline inputs (52px tap target), paper grain texture, Inter Light 300 added. Color system identical to V1. Compare with design-system/tokens.json for V1.",
    "v2-changes": [
      "border-radius: all values 0px (drag-handle exception: 2px)",
      "input style: underline only, bottom border, no full box",
      "input tap-target-height: 52px (V1 was 48px)",
      "typography: font-weight.light 300 added",
      "body-sm and meta roles use weight 300",
      "new token groups: input, section, texture"
    ]
  },

  "color": {
    "$description": "Color primitives and semantic aliases -- identical to V1. No color changes in V2.",

    "primitive": {
      "warm-white": { "$value": "#faf9f6", "$type": "color" },
      "paper":      { "$value": "#f4f2ed", "$type": "color" },
      "parchment":  { "$value": "#ede9e0", "$type": "color" },
      "ink":        { "$value": "#1a1a1a", "$type": "color" },
      "graphite":   { "$value": "#3d3d3d", "$type": "color" },
      "slate":      { "$value": "#6b7280", "$type": "color" },
      "fog":        { "$value": "#9ca3af", "$type": "color" },
      "white":      { "$value": "#ffffff", "$type": "color" },

      "sage": {
        "50":  { "$value": "#eef3f0", "$type": "color" },
        "100": { "$value": "#d4e4dc", "$type": "color" },
        "300": { "$value": "#8ab5a4", "$type": "color" },
        "500": { "$value": "#5c7a6b", "$type": "color" },
        "700": { "$value": "#3d5a4f", "$type": "color" },
        "900": { "$value": "#1e2e28", "$type": "color" }
      },

      "amber": {
        "300": { "$value": "#fcd34d", "$type": "color" },
        "500": { "$value": "#f59e0b", "$type": "color" }
      },

      "red": {
        "100": { "$value": "#fee2e2", "$type": "color" },
        "400": { "$value": "#f87171", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" }
      },

      "green": {
        "100": { "$value": "#dcfce7", "$type": "color" },
        "400": { "$value": "#4ade80", "$type": "color" },
        "600": { "$value": "#16a34a", "$type": "color" }
      },

      "dark": {
        "base":           { "$value": "#0f1117", "$type": "color" },
        "surface":        { "$value": "#1a1d27", "$type": "color" },
        "surface-raised": { "$value": "#22263a", "$type": "color" },
        "border":         { "$value": "#2a2d3a", "$type": "color" },
        "text-primary":   { "$value": "#f0ede8", "$type": "color" },
        "text-secondary": { "$value": "#9ca3af", "$type": "color" },
        "text-muted":     { "$value": "#6b7280", "$type": "color" }
      }
    },

    "semantic": {
      "$description": "Semantic aliases -- components consume these, not primitives. Identical to V1.",

      "background": {
        "app":     { "$value": "{color.primitive.warm-white}", "$type": "color" },
        "surface": { "$value": "{color.primitive.paper}",      "$type": "color" },
        "inset":   { "$value": "{color.primitive.parchment}",  "$type": "color" },
        "overlay": { "$value": "rgba(26, 26, 26, 0.48)",       "$type": "color" }
      },

      "text": {
        "primary":     { "$value": "{color.primitive.ink}",      "$type": "color" },
        "secondary":   { "$value": "{color.primitive.graphite}", "$type": "color" },
        "muted":       { "$value": "{color.primitive.slate}",    "$type": "color" },
        "placeholder": { "$value": "{color.primitive.fog}",      "$type": "color" },
        "disabled":    { "$value": "{color.primitive.fog}",      "$type": "color" },
        "on-accent":   { "$value": "{color.primitive.white}",    "$type": "color" }
      },

      "border": {
        "default": { "$value": "{color.primitive.parchment}",  "$type": "color" },
        "strong":  { "$value": "{color.primitive.slate}",      "$type": "color" },
        "focus":   { "$value": "{color.primitive.sage.500}",   "$type": "color" }
      },

      "accent": {
        "default":   { "$value": "{color.primitive.sage.500}", "$type": "color" },
        "hover":     { "$value": "{color.primitive.sage.700}", "$type": "color" },
        "pressed":   { "$value": "{color.primitive.sage.700}", "$type": "color" },
        "subtle":    { "$value": "{color.primitive.sage.50}",  "$type": "color" },
        "muted":     { "$value": "{color.primitive.sage.100}", "$type": "color" },
        "on-accent": { "$value": "{color.primitive.white}",    "$type": "color" }
      },

      "status": {
        "error-bg":       { "$value": "{color.primitive.red.100}",   "$type": "color" },
        "error-text":     { "$value": "{color.primitive.red.600}",   "$type": "color" },
        "error-border":   { "$value": "{color.primitive.red.400}",   "$type": "color" },
        "warning-bg":     { "$value": "#fffbeb",                     "$type": "color" },
        "warning-text":   { "$value": "{color.primitive.amber.500}", "$type": "color" },
        "warning-border": { "$value": "{color.primitive.amber.300}", "$type": "color" },
        "success-bg":     { "$value": "{color.primitive.green.100}", "$type": "color" },
        "success-text":   { "$value": "{color.primitive.green.600}", "$type": "color" },
        "success-border": { "$value": "{color.primitive.green.400}", "$type": "color" },
        "info-bg":        { "$value": "{color.primitive.sage.50}",   "$type": "color" },
        "info-text":      { "$value": "{color.primitive.sage.700}",  "$type": "color" },
        "info-border":    { "$value": "{color.primitive.sage.100}",  "$type": "color" }
      },

      "dark": {
        "$description": "Dark theme semantic overrides. Activated via [data-theme=dark]. Same structure as V1.",
        "$status": "structured and ready -- populate when dark mode ships",
        "background": {
          "app":     { "$value": "{color.primitive.dark.base}",           "$type": "color" },
          "surface": { "$value": "{color.primitive.dark.surface}",        "$type": "color" },
          "inset":   { "$value": "{color.primitive.dark.surface-raised}", "$type": "color" }
        },
        "text": {
          "primary":   { "$value": "{color.primitive.dark.text-primary}",   "$type": "color" },
          "secondary": { "$value": "{color.primitive.dark.text-secondary}", "$type": "color" },
          "muted":     { "$value": "{color.primitive.dark.text-muted}",     "$type": "color" }
        },
        "border": {
          "default": { "$value": "{color.primitive.dark.border}", "$type": "color" },
          "focus":   { "$value": "{color.primitive.sage.300}",    "$type": "color" }
        },
        "accent": {
          "default": { "$value": "{color.primitive.sage.300}", "$type": "color" },
          "hover":   { "$value": "{color.primitive.sage.100}", "$type": "color" },
          "subtle":  { "$value": "{color.primitive.sage.900}", "$type": "color" }
        }
      }
    }
  },

  "typography": {
    "$description": "V2 extends V1 weight range down to Light 300 for body-sm and meta roles.",

    "font-family": {
      "base": {
        "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
        "$type": "fontFamily"
      }
    },

    "font-size": {
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "md":   { "$value": "18px", "$type": "dimension" },
      "lg":   { "$value": "20px", "$type": "dimension" },
      "xl":   { "$value": "24px", "$type": "dimension" },
      "2xl":  { "$value": "30px", "$type": "dimension" },
      "3xl":  { "$value": "38px", "$type": "dimension" }
    },

    "font-weight": {
      "light":    { "$value": "300", "$type": "fontWeight", "$description": "V2 addition -- helper text, metadata, secondary info" },
      "regular":  { "$value": "400", "$type": "fontWeight" },
      "medium":   { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold":     { "$value": "700", "$type": "fontWeight" }
    },

    "line-height": {
      "tight":   { "$value": "1.2",  "$type": "number" },
      "snug":    { "$value": "1.35", "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.65", "$type": "number" }
    },

    "letter-spacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em",     "$type": "dimension" },
      "wide":   { "$value": "0.04em",  "$type": "dimension" },
      "widest": { "$value": "0.08em",  "$type": "dimension" }
    },

    "roles": {
      "$description": "Semantic type roles with size + weight + leading. body-sm and meta use weight 300 (V2 change).",
      "display-xl": { "$value": { "fontSize": "38px", "fontWeight": "700", "lineHeight": "1.2"  }, "$type": "typography" },
      "display-lg": { "$value": { "fontSize": "30px", "fontWeight": "600", "lineHeight": "1.2"  }, "$type": "typography" },
      "display-md": { "$value": { "fontSize": "20px", "fontWeight": "600", "lineHeight": "1.35" }, "$type": "typography" },
      "body-lg":    { "$value": { "fontSize": "18px", "fontWeight": "400", "lineHeight": "1.5"  }, "$type": "typography" },
      "body-base":  { "$value": { "fontSize": "16px", "fontWeight": "400", "lineHeight": "1.5"  }, "$type": "typography" },
      "body-sm":    { "$value": { "fontSize": "13px", "fontWeight": "300", "lineHeight": "1.5"  }, "$type": "typography", "$description": "V2 change: weight 300 Light (V1 was 400 Regular)" },
      "label-lg":   { "$value": { "fontSize": "14px", "fontWeight": "500", "lineHeight": "1.4"  }, "$type": "typography" },
      "label-md":   { "$value": { "fontSize": "12px", "fontWeight": "500", "lineHeight": "1.4"  }, "$type": "typography" },
      "label-sm":   { "$value": { "fontSize": "11px", "fontWeight": "500", "lineHeight": "1.3"  }, "$type": "typography" },
      "meta":       { "$value": { "fontSize": "11px", "fontWeight": "300", "lineHeight": "1.3"  }, "$type": "typography", "$description": "V2 new role: timestamps, metadata, fine print" },
      "mono":       { "$value": { "fontSize": "13px", "fontWeight": "400", "lineHeight": "1.5"  }, "$type": "typography" }
    }
  },

  "spacing": {
    "$description": "4px base grid -- unchanged from V1",
    "0":  { "$value": "0px",  "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "7":  { "$value": "28px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "14": { "$value": "56px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },

  "border-radius": {
    "$description": "V2: ALL values are 0px. Sharp corners everywhere. This is the primary V2 visual differentiator from V1.",
    "none":        { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was also 0px" },
    "sm":          { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was 4px" },
    "md":          { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was 8px" },
    "lg":          { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was 12px" },
    "xl":          { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was 16px" },
    "2xl":         { "$value": "0px",    "$type": "dimension", "$description": "0px -- V1 was 24px" },
    "full":        { "$value": "9999px", "$type": "dimension", "$description": "Retained: drag handle pills and pill badges only" },
    "drag-handle": { "$value": "2px",    "$type": "dimension", "$description": "Functional exception: bottom sheet grip bar only" }
  },

  "input": {
    "$description": "V2 input style system -- underline only, no full border box. V1 used box style.",
    "style":                { "$value": "underline", "$type": "string" },
    "border-width-default": { "$value": "1.5px",     "$type": "dimension" },
    "border-width-focus":   { "$value": "2px",        "$type": "dimension" },
    "border-color-default": { "$value": "{color.primitive.parchment}", "$type": "color" },
    "border-color-focus":   { "$value": "{color.primitive.sage.500}",  "$type": "color" },
    "border-color-error":   { "$value": "{color.primitive.red.600}",   "$type": "color" },
    "border-color-disabled":{ "$value": "{color.primitive.parchment}", "$type": "color" },
    "tap-target-height":    { "$value": "52px", "$type": "dimension", "$description": "V1 was 48px -- increased for underline inputs on mobile" },
    "bg-readonly":          { "$value": "{color.primitive.parchment}", "$type": "color" },
    "opacity-disabled":     { "$value": "0.4", "$type": "number" }
  },

  "section": {
    "$description": "V2 section grouping tokens -- replaces full-border card containers from V1.",
    "divider-width":     { "$value": "1px",  "$type": "dimension" },
    "divider-color":     { "$value": "{color.primitive.parchment}", "$type": "color" },
    "accent-bar-width":  { "$value": "3px",  "$type": "dimension", "$description": "Left edge sage bar for grouped sections" },
    "accent-bar-color":  { "$value": "{color.primitive.sage.500}", "$type": "color" },
    "accent-bar-indent": { "$value": "16px", "$type": "dimension", "$description": "Content indent from left edge when accent bar present" }
  },

  "texture": {
    "$description": "V2 paper grain surface treatment -- inline SVG noise, zero HTTP requests.",
    "grain-opacity-light":     { "$value": "0.025", "$type": "number", "$description": "2.5% opacity on light bg -- visible on inspection, invisible at a glance" },
    "grain-opacity-dark":      { "$value": "0.040", "$type": "number", "$description": "4.0% opacity on dark bg -- needs more intensity to read" },
    "grain-base-frequency":    { "$value": "0.65",  "$type": "number", "$description": "SVG feTurbulence baseFrequency -- controls grain scale" },
    "grain-octaves":           { "$value": "3",     "$type": "number" }
  },

  "shadow": {
    "$description": "Unchanged from V1. Shadows used for modals/sheets, not cards (V2 uses hairlines for cards).",
    "none":        { "$value": "none", "$type": "shadow" },
    "xs":          { "$value": "0 1px 2px rgba(26, 26, 26, 0.06)", "$type": "shadow" },
    "sm":          { "$value": "0 1px 3px rgba(26, 26, 26, 0.08), 0 1px 2px rgba(26, 26, 26, 0.06)", "$type": "shadow" },
    "md":          { "$value": "0 4px 6px rgba(26, 26, 26, 0.06), 0 2px 4px rgba(26, 26, 26, 0.08)", "$type": "shadow" },
    "lg":          { "$value": "0 10px 15px rgba(26, 26, 26, 0.08), 0 4px 6px rgba(26, 26, 26, 0.05)", "$type": "shadow" },
    "xl":          { "$value": "0 20px 25px rgba(26, 26, 26, 0.10), 0 10px 10px rgba(26, 26, 26, 0.04)", "$type": "shadow" },
    "focus":       { "$value": "0 0 0 3px rgba(92, 122, 107, 0.32)", "$type": "shadow" },
    "focus-error": { "$value": "0 0 0 3px rgba(220, 38, 38, 0.24)", "$type": "shadow" }
  },

  "z-index": {
    "base":     { "$value": "0",   "$type": "number" },
    "raised":   { "$value": "10",  "$type": "number" },
    "dropdown": { "$value": "100", "$type": "number" },
    "sticky":   { "$value": "200", "$type": "number" },
    "overlay":  { "$value": "300", "$type": "number" },
    "modal":    { "$value": "400", "$type": "number" },
    "toast":    { "$value": "500", "$type": "number" },
    "tooltip":  { "$value": "600", "$type": "number" }
  },

  "motion": {
    "duration": {
      "instant":  { "$value": "0ms",   "$type": "duration" },
      "fast":     { "$value": "100ms", "$type": "duration" },
      "normal":   { "$value": "150ms", "$type": "duration" },
      "moderate": { "$value": "200ms", "$type": "duration" },
      "slow":     { "$value": "300ms", "$type": "duration" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0.2, 1)",   "$type": "cubicBezier" },
      "accelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)",   "$type": "cubicBezier" }
    }
  },

  "border-width": {
    "none":   { "$value": "0px", "$type": "dimension" },
    "thin":   { "$value": "1px", "$type": "dimension" },
    "medium": { "$value": "2px", "$type": "dimension" },
    "thick":  { "$value": "3px", "$type": "dimension", "$description": "Used for accent bar width" }
  },

  "icon": {
    "size": {
      "xs":   { "$value": "12px", "$type": "dimension" },
      "sm":   { "$value": "16px", "$type": "dimension" },
      "md":   { "$value": "20px", "$type": "dimension" },
      "base": { "$value": "24px", "$type": "dimension" },
      "lg":   { "$value": "32px", "$type": "dimension" }
    },
    "stroke-width": { "$value": "1.5", "$type": "number" }
  }
}
